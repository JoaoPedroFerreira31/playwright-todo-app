{
  // Frontend (browser). Compila client/*.ts para public/js/*.js como módulos ES.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "../public/js"
  },
  "include": ["."]
}
