{
  "name": "playwright-todo",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch --disable-warning=ExperimentalWarning src/server.ts\" \"tsc -p client --watch --preserveWatchOutput\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p client",
    "build:server": "tsc -p tsconfig.build.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p client --noEmit",
    "db:reset": "tsx --disable-warning=ExperimentalWarning src/scripts/reset-db.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "codegen": "playwright codegen http://localhost:3000",
    "report": "playwright show-report"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
