{
  // Configuração base: servidor (src/), testes e playwright.config.ts.
  // Só faz verificação de tipos — a compilação do servidor usa tsconfig.build.json
  // e o frontend tem o seu próprio client/tsconfig.json.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
